#!/usr/bin/env sh
# One-shot initializer for the private Compose network's MySQL certificates.
set -eu
umask 077
if [ ! -f /mysql-tls/server-cert.pem ]; then
  temporary=$(mktemp -d /mysql-tls/.initialize.XXXXXX)
  trap 'rm -rf "$temporary"' EXIT
  openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
    -subj '/CN=bronko.media internal CA' \
    -keyout "$temporary/ca-key.pem" -out "$temporary/ca.pem" 2>/dev/null
  openssl req -newkey rsa:2048 -nodes -subj '/CN=bronko.media.db' \
    -keyout "$temporary/server-key.pem" -out "$temporary/server.csr" 2>/dev/null
  printf 'subjectAltName=DNS:bronko.media.db\nextendedKeyUsage=serverAuth\n' > "$temporary/extensions"
  openssl x509 -req -days 3650 -in "$temporary/server.csr" \
    -CA "$temporary/ca.pem" -CAkey "$temporary/ca-key.pem" -set_serial 1 \
    -extfile "$temporary/extensions" -out "$temporary/server-cert.pem" 2>/dev/null
  cp "$temporary/ca.pem" "$temporary/server-key.pem" /mysql-tls/
  # Publish the certificate last, so interrupted initialization can be retried.
  cp "$temporary/server-cert.pem" /mysql-tls/
fi
openssl x509 -checkend 86400 -noout -in /mysql-tls/server-cert.pem || {
  echo 'MySQL TLS certificate expires soon. Rotate the Compose TLS volumes before restarting.' >&2
  exit 1
}
chown -R 999:999 /mysql-tls
chmod 750 /mysql-tls
chmod 600 /mysql-tls/server-key.pem
chmod 644 /mysql-tls/ca.pem /mysql-tls/server-cert.pem
cp /mysql-tls/ca.pem /mysql-ca/ca.pem
chmod 755 /mysql-ca
chmod 644 /mysql-ca/ca.pem
