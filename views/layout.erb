<!doctype html>
<html lang="en">
  <head>
    <title>Bronko Media</title>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="/css/bootstrap5.min.css" />
    <link rel="stylesheet" href="/css/fancybox6.css" />
    <link rel="stylesheet" href="/css/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/bronko.media.css" />

    <link rel="icon" href="/images/favicon.ico" />

    <script src="/js/bootstrap5.bundle.min.js"></script>
    <script src="/js/fancybox6.umd.js"></script>
    <script src="/js/pagy.min.js"></script>
  </head>
  <body>
  <nav class="navbar navbar-expand-md bg-dark" data-bs-theme="dark">
    <div class="container-fluid">
      <span class="navbar-brand">BMS</span>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
              aria-controls="mainNavigation" aria-expanded="false" data-tooltip title="Toggle navigation" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="mainNavigation">
        <ul class="navbar-nav mx-auto">
          <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/folders">Folders</a></li>
          <li class="nav-item"><a class="nav-link" href="/duplicates">Duplicates</a></li>
          <li class="nav-item"><a class="nav-link" href="/favorites">Favorites</a></li>
          <li class="nav-item"><a class="nav-link" href="/search">Search</a></li>
          <li class="nav-item"><a class="nav-link" href="/tags">Tags</a></li>
          <li class="nav-item verticalLine"><a class="nav-link" href="/config">Config</a></li>
        </ul>
        <span class="navbar-text"><%= BronkoMedia::VERSION %></span>
      </div>
    </div>
  </nav>
    <br/>

    <div class="container-fluid">
      <%= yield %>
    </div>

    <script src="/js/tooltips.js"></script>

    <script src="/js/selected_images.js"></script>

  <% loop_attribute = if Settings.video_do_loop == 'true'
                        'loop'
                      else
                        ''
                      end
  %>

    <script type="text/javascript">
      Fancybox.bind('[data-fancybox]', {
        Html : {
          videoTpl : `<video class="fancybox__html5video" <%= loop_attribute %> playsinline controls poster="{{poster}}"><source src="{{src}}" type="{{format}}" />Sorry, your browser doesn't support embedded videos.</video>`
        },
        Images: {
          zoom: false,
        },
        Thumbs: {
          showOnStart: false,
        },
        Toolbar: {
          enabled: false,
        },
        closeButton: false,
        }
      );
    </script>
  </body>
</html>
