<% short_md5 = truncate(media.md5_path, length: 8, omission: '') %>

<!-- nav bar & menu -->
<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <%- breadcrumbs = media.folder_path.split("/") -%>
      <%- breadcrumbs.each_with_index do |breadcrump, i| -%>
        <%- if i == 0 -%>
        <li class="breadcrumb-item">
          <a href="/folders" class="bi bi-collection" data-tooltip title="Open folders" aria-label="Open folders"></a>
        </li>
      <%- elsif i == 1 -%>
      <%- else -%>
        <li class="breadcrumb-item">
          <a href="/folders/<%= ERB::Util.url_encode breadcrumbs.take(i).join('/') %>/<%= ERB::Util.url_encode breadcrump %>/"><%= breadcrump %></a>
        </li>
      <%- end -%>
    <%- end -%>
    <%- unless is_folder -%>
    <li class="breadcrumb-item">
      <%= media.image_name %>.<%= media.extension %>
    </li>
    <%- end -%>
  </ol>
</nav>

<div class="btn-toolbar">
  <button class="btn btn-outline-primary btn-sm me-1 bi bi-arrow-up"       type="button" onclick="history.back()" data-tooltip title="Go back" aria-label="Go back"></button>
  <button class="btn btn-outline-info    btn-sm me-1 bi bi-folder-symlink" type="button" data-bs-toggle="modal" data-bs-target="#Move<%= short_md5 %>Modal" data-tooltip title="Move media" aria-label="Move media"></button>
  <button class="btn btn-outline-info    btn-sm me-1 bi bi-tags"           type="button" data-bs-toggle="modal" data-bs-target="#Tag<%= short_md5 %>Modal" data-tooltip title="Edit tags" aria-label="Edit tags"></button>
  <%- unless is_folder -%>
  <button class="btn btn-outline-warning btn-sm me-1 bi bi-bookmark-star"  type="button" onclick="addFavorite(this)" value="<%= media.md5_path %>" data-favorite="<%= media.favorite %>" data-tooltip title="<%= media.favorite ? 'Remove from favorites' : 'Add to favorites' %>" aria-label="<%= media.favorite ? 'Remove from favorites' : 'Add to favorites' %>"></button>
  <%- end -%>
  <button class="btn btn-outline-warning btn-sm me-1 bi bi-recycle"        type="button" onclick="recreateThumb(this)" value="<%= media.md5_path %>" data-tooltip title="Recreate thumbnail" aria-label="Recreate thumbnail"></button>
  <button class="btn btn-outline-danger  btn-sm me-1 bi bi-trash"          type="button" data-bs-toggle="modal" data-bs-target="#Delete<%= short_md5 %>Modal" data-tooltip title="Delete media" aria-label="Delete media"></button>
</div>
<hr />

<%- if is_folder -%>
<div class="container">
  ID: <small><%= media.id %></small><br>
  Folder: <small><%= media.folder_path %></small><br>
  MD5 Path: <small><%= media.md5_path %></small><br>
  <br />
  Parent Folder: <small><%= media.parent_folder %></small><br>
  Sub Folder: <small><%= media.sub_folders %></small><br>
  Files in Folder: <small><%= files_in_folder.count %></small><br>
  <br />
  Created: <small><%= media.created_at %></small><br>
  Updated: <small><%= media.updated_at %></small><br>
  <br />
</div>
<%- else -%>
  <%- if media.is_image -%>
  <div class="container" >
    <img class="img-fluid d-block" src="/image/<%= media.md5_path %>" >
  </div>
  <%- end -%>

  <% if Settings.video_do_loop == 'true'
       loop_attribute = 'loop'
      else
       loop_attribute = ''
  end %>

  <%- if media.is_video -%>
  <div class="container">
    <video controls <%= loop_attribute %> src="/image/<%= media.md5_path %>" ></video>
  </div>
  <%- end -%>

<hr />
<%= erb :_image_info, locals: { media: media } %>
<%- end -%>
