<%- state = '' -%>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <%- breadcrumbs = folder_root.split("/") -%>
      <%- breadcrumbs.each_with_index do |breadcrump, i| -%>
        <%- if i == 0 -%>
        <li class="breadcrumb-item">
          <a href="/folders" class="bi bi-collection" data-tooltip title="Open folders" aria-label="Open folders"></a>
        </li>
      <%- elsif i == 1 -%>
      <%- else -%>
        <li class="breadcrumb-item">
          <a href="/folders/<%= ERB::Util.url_encode breadcrumbs.take(i).join('/') %>/<%= ERB::Util.url_encode breadcrump %>/"><%= breadcrump %></a>
        </li>
      <%- end -%>
    <%- end -%>
  </ol>
</nav>

<%- unless current_folder.nil? -%>
<div class="btn-toolbar">
<%- state = 'disabled' if folder_root == "#{Settings.originals_path}/" -%>
  <%- if state == 'disabled' -%>
  <span class="d-inline-block" tabindex="0" data-tooltip title="Already in the root folder" aria-label="Already in the root folder">
    <a class="btn btn-outline-primary btn-sm me-1 mb-1 bi bi-arrow-up disabled" aria-disabled="true" tabindex="-1" style="pointer-events: none;"></a>
  </span>
  <%- else -%>
  <a class="btn btn-outline-primary btn-sm me-1 mb-1 bi bi-arrow-up <%= state %>" href="/folders/<%= parent_folder %>" data-tooltip title="Open parent folder" aria-label="Open parent folder"></a>
  <%- end -%>
<%- entry_point.sort.each do |entry| -%>
  <a class="btn btn_bc btn-outline-primary btn-sm me-1 mb-1" href="/folders/<%= ERB::Util.url_encode entry %>" data-tooltip title="Open folder" aria-label="Open folder"><%= entry.split('/').last %></a>
<%- end -%>
<div class="btn-group me-1 mb-1" role="group">
  <button class="btn btn_black btn-outline-secondary btn-sm bi bi-plus-lg"            type="button" data-bs-toggle="modal" data-bs-target="#FolderPlusModal" data-tooltip title="Create folder" aria-label="Create folder"></button>
  <button class="btn btn_black btn-outline-info      btn-sm bi bi-cloud-arrow-up"     type="button" data-bs-toggle="modal" data-bs-target="#FolderUploadModal" data-tooltip title="Upload media" aria-label="Upload media"></button>
  <button class="btn btn_black btn-outline-info      btn-sm bi bi-arrow-left-right"   type="button" data-bs-toggle="modal" data-bs-target="#FolderMoveModal" data-tooltip title="Move folder" aria-label="Move folder"></button>
  <button class="btn btn_black btn-outline-info      btn-sm bi bi-file-earmark-break" type="button" data-bs-toggle="modal" data-bs-target="#FolderScanModal" data-tooltip title="Scan folder" aria-label="Scan folder"></button>
  <a      class="btn btn_black btn-outline-info      btn-sm bi bi-film"               type="button" href="/folders/<%= this_folder %>?media=videos" data-tooltip title="Show videos" aria-label="Show videos"></a>
  <a      class="btn btn_black btn-outline-info      btn-sm bi bi-image"              type="button" href="/folders/<%= this_folder %>?media=images" data-tooltip title="Show images" aria-label="Show images"></a>
  <button class="btn btn_black btn-outline-danger    btn-sm bi bi-trash"              type="button" data-bs-toggle="modal" data-bs-target="#FolderDeleteModal" data-tooltip title="Delete folder" aria-label="Delete folder"></button>
</div>
<div class="btn-group mb-1" role="group">
    <a class="btn btn_black btn-outline-primary btn-sm bi bi-arrow-up-right me-1" type="button" href="/media/info/<%= folder.md5_path %>" data-tooltip title="Open folder information" aria-label="Open folder information"></a>
</div>
<div class="btn-group mb-1" role="group">
    <button class="btn btn_black btn-outline-warning btn-sm bi bi-arrow-left-right" type="button" data-bs-toggle="modal" data-bs-target="#ImagesMoveModal"  data-tooltip title="Move selected media" aria-label="Move selected media"></button>
    <button class="btn btn_black btn-outline-warning btn-sm bi bi-trash"            type="button" data-bs-toggle="modal" data-bs-target="#ImagesDeleteModal"  data-tooltip title="Delete selected media" aria-label="Delete selected media"></button>
</div>
</div>

  <%- unless images.empty? -%>
    <%= erb :_paginator, locals: {images: images, pagy: pagy} %>
    <div class="row mt-1"><%= erb :_image_cards, locals: {images: images, show_path: false} %></div>
    <% if pagy.pages > 1 %>
      <%= erb :_paginator, locals: {images: images, pagy: pagy} %>
    <% end %>
  <% end %>

  <%= erb :_folder_modals, locals: {folder: folder, this_folder: this_folder} %>
<%- end -%>
