<%- settings_yaml = YAML.load_file('config/settings.yml') -%>

<%- unless params.empty?
  Settings.each do |setting|
    if setting.first.to_s.include? 'extention'
      settings_yaml[setting.first.to_s] = params[setting.first].split(',')
    elsif setting.first.to_s == 'threads'
      settings_yaml[setting.first.to_s] = params[setting.first].to_i
    elsif setting.first.to_s == 'images_per_page'
      settings_yaml[setting.first.to_s] = params[setting.first].to_i
    else
      settings_yaml[setting.first.to_s] = params[setting.first]
    end
  end

  File.open("config/settings.yml", "w") { |file| file.write(settings_yaml.to_yaml) }
  Settings.reload!
end -%>

  <%- unless params.empty? -%>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    All settings have been saved!
    <button type="button" class="btn-close" data-bs-dismiss="alert" data-tooltip title="Dismiss notification" aria-label="Dismiss notification"></button>
  </div>
  <%- end -%>

<div class="row ms-1">
  <div class="col-4">
    <form action="/config" method="get" >

  <%- Settings.each do |setting| -%>
    <div class="input-group mb-1">
        <div class="input-group-text"><%= setting.first %></div>
        <%- if setting.last.is_a? Array -%>
        <input type="text" class="form-control" name="<%= setting.first %>" value="<%= setting.last.join(',') %>" >
        <%- else -%>
        <input type="text" class="form-control" name="<%= setting.first %>" value="<%= setting.last %>" >
        <%- end -%>
      </div>
  <%- end -%>

      <button type="submit" class="btn btn-primary" data-tooltip title="Save settings" aria-label="Save settings">Submit</button>
    </form>
  </div>
</div>

<br>
This may take a while...
<div class="row ms-1">
  <a class="btn btn-danger" href="/indexer" data-tooltip title="Index media files" aria-label="Index media files">Online Indexer</a>
</div>

<br>
This may take a while...
<div class="row ms-1">
  <a class="btn btn-outline-danger" href="/duplicate/scan" data-tooltip title="Scan for duplicate media" aria-label="Scan for duplicate media">Online Duplicate Scan</a>
</div>
