  <%- if saved -%>
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    All settings have been saved!
    <button type="button" class="btn-close" data-bs-dismiss="alert" data-tooltip title="Dismiss notification" aria-label="Dismiss notification"></button>
  </div>
  <%- end -%>

<div class="row ms-1">
  <div class="col-4">
    <form action="/config" method="post" >

      <input type="hidden" name="config_token" value="<%= Rack::Utils.escape_html(config_token) %>">
  <%- editable_settings.each do |key| -%>
    <%- setting = [key, Settings[key]] -%>
    <div class="input-group mb-1">
        <div class="input-group-text"><%= Rack::Utils.escape_html(setting.first) %></div>
        <%- if setting.last.is_a? Array -%>
        <input type="text" class="form-control" name="<%= Rack::Utils.escape_html(setting.first) %>" value="<%= Rack::Utils.escape_html(setting.last.join(',')) %>" >
        <%- else -%>
        <input type="text" class="form-control" name="<%= Rack::Utils.escape_html(setting.first) %>" value="<%= Rack::Utils.escape_html(setting.last.to_s) %>" >
        <%- end -%>
      </div>
  <%- end -%>

      <button type="submit" class="btn btn-primary" data-tooltip title="Save settings" aria-label="Save settings">Submit</button>
    </form>
  </div>
</div>

<br>
This may take a while...
<div class="row ms-1">
  <a class="btn btn-danger" href="/indexer" data-tooltip title="Index media files" aria-label="Index media files">Online Indexer</a>
</div>

<br>
This may take a while...
<div class="row ms-1">
  <a class="btn btn-outline-danger" href="/duplicate/scan" data-tooltip title="Scan for duplicate media" aria-label="Scan for duplicate media">Online Duplicate Scan</a>
</div>

<p>Storage paths and database credentials are configured in config/settings.yml. Restart the application after changing them.</p>
