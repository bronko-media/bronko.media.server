<h3>Search</h3>
<div class="row ms-1">
  <form action="/search" method="get" >
    <div class="input-group">
      <div class="input-group-text fixed-width">Name</div>
      <input type="text" class="form-control" name="search">
      <button type="submit" class="btn btn-outline-primary ms-2" data-tooltip title="Search media by name" aria-label="Search media by name">Search</button>
    </div>
  </form>
</div>

<br \>

<%- unless search.nil? -%>
<%= erb :_paginator, locals: {images: search, pagy: pagy} %>

<div class="row mt-1">
  <%= erb :_image_cards, locals: {images: search, show_path: true} %>
</div>

<%= erb :_paginator, locals: {images: search, pagy: pagy} %>
<%- end -%>
