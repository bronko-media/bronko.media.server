<div class="btn-toolbar">
  <form method="get">
  <%- tags.each do |tag| -%>
    <button class="btn btn-outline-primary btn-sm me-1 mb-1" type="submit" name="tag" value="<%= tag.name %>" action="/tags" data-tooltip title="Filter media by this tag" aria-label="Filter media by this tag"><%= tag.name %></button>
  <%- end -%>
  </form>
</div>

<%- unless images.nil? -%>
<%= erb :_paginator, locals: {images: images, pagy: pagy} %>

<div class="row mt-1">
  <%= erb :_image_cards, locals: {images: images, show_path: false} %>
</div>

<%= erb :_paginator, locals: {images: images, pagy: pagy} %>
<%- end -%>
